<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose dessine tout ; ce theme ne sert qu'au demarrage, le temps
         que la premiere image arrive. Sans barre de titre, et de la couleur
         de l'accueil. -->
    <style name="Theme.Kilometres" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
