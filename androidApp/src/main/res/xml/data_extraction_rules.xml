<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus : sauvegarde cloud et transfert d'appareil a appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="kilometres-data.json" />
        <include domain="file" path="kilometres-entitlement.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="kilometres-data.json" />
        <include domain="file" path="kilometres-entitlement.json" />
    </device-transfer>
</data-extraction-rules>
